  "conditions":{"type":"text","dbType":"longtext"},
  "effectiveFrom":{"type":"datetime"},
  "effectiveTo":{"type":"datetime"},
  "policyRevision":{"type":"varchar","maxLength":255},
  "sourceEvidenceRefs":{"type":"text","dbType":"longtext"},
  "revisionNumber":{"type":"int","default":1,"readOnly":true},
